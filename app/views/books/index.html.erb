<% content_for :title, "Books" %>

<h1>You're logged in! Welcome, <%= current_admin.full_name.presence || current_admin.email %>!</h1>
<%= button_to "Sign Out",
  destroy_admin_session_path,
  class: "oauth-link",
  form_class: "oauth-link-form",
  method: :delete %>

<h2>Books</h2>

<div id="books">
  <% @books.each do |book| %>
    <%= render book %>
    <p>
      <%= link_to "Show this book", book %>
    </p>
  <% end %>
</div>

<%= link_to "New book", new_book_path %>
